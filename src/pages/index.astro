---
// Custom landing page — not a Starlight page.
// Self-contained with inline styles, imports JetBrains Mono.
import '@fontsource-variable/jetbrains-mono';
import AsciinemaPlayer from '../components/AsciinemaPlayer.astro';
import 'asciinema-player/dist/bundle/asciinema-player.css';
import '../styles/asciinema-theme.css';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Reflex — Local-first code search engine</title>
		<meta
			name="description"
			content="Full-text search, symbol extraction, and dependency analysis for AI coding workflows. Millisecond queries. 15 parsed languages plus every text file. Deterministic results."
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<style>
			*,
			*::before,
			*::after {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			:root {
				--bg: #1a2530;
				--bg-deep: #121d26;
				--accent: #e8722a;
				--accent-hover: #f5893f;
				--text: #e8dcc8;
				--text-dim: #a89b89;
				--surface: #252d38;
				--border: #3a332c;
				--mono: 'JetBrains Mono Variable', ui-monospace, 'Cascadia Code',
					'Source Code Pro', Menlo, Consolas, monospace;
			}

			html {
				color-scheme: dark;
			}

			body {
				font-family: var(--mono);
				background: var(--bg);
				color: var(--text);
				line-height: 1.6;
			}

			a {
				color: var(--accent);
				text-decoration: none;
			}

			a:hover {
				color: var(--accent-hover);
			}

			/* Nav */
			nav {
				display: flex;
				align-items: center;
				justify-content: space-between;
				max-width: 1100px;
				margin: 0 auto;
				padding: 1.5rem 2rem;
			}

			.wordmark {
				font-size: 1.25rem;
				font-weight: 700;
				letter-spacing: -0.02em;
			}

			.wordmark .chevrons {
				color: var(--accent);
			}

			.nav-links {
				display: flex;
				gap: 2rem;
				list-style: none;
				font-size: 0.875rem;
			}

			.nav-links a {
				color: var(--text-dim);
			}

			.nav-links a:hover {
				color: var(--text);
			}

			/* Hero */
			.hero {
				text-align: center;
				padding: 5rem 2rem 4rem;
				max-width: 800px;
				margin: 0 auto;
			}

			.hero h1 {
				font-size: 3rem;
				font-weight: 700;
				letter-spacing: -0.03em;
				margin-bottom: 1rem;
			}

			.hero h1 .chevrons {
				color: var(--accent);
			}

			.hero .tagline {
				font-size: 1.125rem;
				color: var(--text-dim);
				max-width: 600px;
				margin: 0 auto 2.5rem;
				line-height: 1.7;
			}

			.install-block {
				background: var(--bg-deep);
				border: 1px solid var(--border);
				border-radius: 8px;
				padding: 1rem 1.5rem;
				font-size: 0.9rem;
				display: inline-block;
				margin-bottom: 2.5rem;
				color: var(--text-dim);
			}

			.install-block code {
				color: var(--text);
			}

			.install-block .prompt {
				color: var(--accent);
			}

			.cta-group {
				display: flex;
				gap: 1rem;
				justify-content: center;
				flex-wrap: wrap;
			}

			.btn {
				display: inline-block;
				padding: 0.75rem 1.75rem;
				border-radius: 6px;
				font-family: var(--mono);
				font-size: 0.875rem;
				font-weight: 600;
				transition: background 0.15s;
			}

			.btn-primary {
				background: var(--accent);
				color: var(--bg-deep);
			}

			.btn-primary:hover {
				background: var(--accent-hover);
				color: var(--bg-deep);
			}

			.btn-secondary {
				background: var(--surface);
				color: var(--text);
				border: 1px solid var(--border);
			}

			.btn-secondary:hover {
				background: var(--border);
				color: var(--text);
			}

			/* Features */
			.features {
				max-width: 1100px;
				margin: 0 auto;
				padding: 4rem 2rem;
			}

			.features h2 {
				text-align: center;
				font-size: 1.5rem;
				margin-bottom: 2.5rem;
				font-weight: 600;
			}

			.feature-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.25rem;
			}

			.feature-card {
				background: var(--bg-deep);
				border: 1px solid var(--border);
				border-radius: 8px;
				padding: 1.5rem;
			}

			.feature-card h3 {
				font-size: 0.9rem;
				font-weight: 600;
				margin-bottom: 0.5rem;
				color: var(--accent);
			}

			.feature-card p {
				font-size: 0.8rem;
				color: var(--text-dim);
				line-height: 1.5;
			}

			/* Code example */
			.code-example {
				max-width: 1000px;
				margin: 0 auto;
				padding: 2rem 2rem 4rem;
			}

			.code-example h2 {
				text-align: center;
				font-size: 1.5rem;
				margin-bottom: 2rem;
				font-weight: 600;
			}

			.terminal {
				background: var(--bg-deep);
				border: 1px solid var(--border);
				border-radius: 8px;
				padding: 1.5rem;
				overflow-x: auto;
				font-size: 0.8rem;
				line-height: 1.7;
			}

			.terminal .prompt {
				color: var(--accent);
			}

			.terminal .cmd {
				color: var(--text);
			}

			.terminal .output {
				color: var(--text-dim);
			}

			.terminal .comment {
				color: #6b5f53;
			}

			/* Install */
			.install {
				text-align: center;
				padding: 4rem 2rem;
			}

			.install h2 {
				font-size: 1.5rem;
				margin-bottom: 2rem;
				font-weight: 600;
			}

			.install-methods {
				display: flex;
				gap: 1.5rem;
				justify-content: center;
				flex-wrap: wrap;
			}

			.install-method {
				background: var(--bg-deep);
				border: 1px solid var(--border);
				border-radius: 8px;
				padding: 1.25rem 2rem;
				font-size: 0.85rem;
			}

			.install-method .label {
				color: var(--text-dim);
				font-size: 0.75rem;
				display: block;
				margin-bottom: 0.5rem;
			}

			.install-method code {
				color: var(--text);
				overflow-wrap: anywhere;
			}

			/* Footer */
			footer {
				text-align: center;
				padding: 3rem 2rem;
				color: var(--text-dim);
				font-size: 0.75rem;
				border-top: 1px solid var(--border);
				max-width: 1100px;
				margin: 0 auto;
			}

			footer a {
				color: var(--text-dim);
			}

			footer a:hover {
				color: var(--text);
			}

			.footer-links {
				display: flex;
				gap: 2rem;
				justify-content: center;
				margin-bottom: 1rem;
			}

			/* Responsive */
			@media (max-width: 768px) {
				.hero h1 {
					font-size: 2rem;
				}
				.feature-grid {
					grid-template-columns: 1fr;
				}
				.install-methods {
					flex-direction: column;
					align-items: center;
				}
			}
		</style>
	</head>
	<body>
		<nav>
			<div class="wordmark">
				<span class="chevrons">&gt;&gt;</span> rfx
			</div>
			<ul class="nav-links">
				<li><a href="/getting-started/">Docs</a></li>
				<li>
					<a href="https://github.com/reflex-search/reflex">GitHub</a>
				</li>
			</ul>
		</nav>

		<section class="hero">
			<h1><span class="chevrons" style="margin-right:1rem;">&gt;&gt;</span>Reflex</h1>
			<p class="tagline">
				Local-first code search engine with full-text search, symbol
				extraction, and dependency analysis for AI coding workflows.
			</p>
			<div class="install-block">
				<span class="prompt">$</span>
				<code>npm install -g reflex-search</code>
			</div>
			<div class="cta-group">
				<a href="/getting-started/" class="btn btn-primary"
					>Read the Docs</a
				>
				<a
					href="https://github.com/reflex-search/reflex"
					class="btn btn-secondary">GitHub</a
				>
			</div>
		</section>

		<section class="features">
			<h2>Why Reflex</h2>
			<div class="feature-grid">
				<div class="feature-card">
					<h3>Fast at Scale</h3>
					<p>
						Indexes a 27,448-file Kubernetes checkout in 7.7s on 16
						cores (was 532s). Median queries on a 30 MB corpus: ~3ms
						for a common word, ~12ms for a regex.
					</p>
				</div>
				<div class="feature-card">
					<h3>Complete Coverage</h3>
					<p>
						Finds every occurrence — not just definitions — across
						the same files ripgrep searches. Whole-identifier
						matching by default, plus substring and case-insensitive
						search.
					</p>
				</div>
				<div class="feature-card">
					<h3>AI-Native</h3>
					<p>
						MCP server with 17 tools, JSON output for agent
						pipelines, built-in AI query assistant. In A/B tests,
						same task success at ~31% lower cost per task.
					</p>
				</div>
				<div class="feature-card">
					<h3>15 Languages + Text</h3>
					<p>
						Rust, TypeScript, Python, Go, Java, C/C++, and more,
						parsed with Tree-sitter for precise symbols. Every other
						non-binary file is indexed for full-text search.
					</p>
				</div>
				<div class="feature-card">
					<h3>Dependency Analysis</h3>
					<p>
						Import tracking, reverse lookups, circular detection,
						hotspot analysis across your entire codebase.
					</p>
				</div>
				<div class="feature-card">
					<h3>Deterministic</h3>
					<p>
						Fully local, fully offline. Same query, same results,
						and every response says whether the index is fresh. Your
						code stays on your machine.
					</p>
				</div>
			</div>
		</section>

		<section class="code-example">
			<h2>See it in action</h2>
			<AsciinemaPlayer
				src="/casts/demo.cast"
				rows={49}
				cols={104}
				autoPlay={true}
				loop={true}
				speed={1.5}
				idleTimeLimit={2}
				fit="width"
			/>
			<noscript>
			<div class="terminal">
				<div>
					<span class="comment"># Index your project</span>
				</div>
				<div>
					<span class="prompt">$</span>
					<span class="cmd"> rfx index</span>
				</div>
				<div>
					<span class="output">Indexing complete!</span>
				</div>
				<div>
					<span class="output"
						>&nbsp;&nbsp;Files indexed: 298</span
					>
				</div>
				<div>
					<span class="output"
						>&nbsp;&nbsp;Index/corpus ratio: 1.3x (trigrams.bin 5.94 MB,
						content.bin 4.42 MB)</span
					>
				</div>
				<div>
					<span class="output"
						>&nbsp;&nbsp;Text: 67 files, Lock: 1, Generated: 0</span
					>
				</div>
				<div>
					<span class="output"
						>Starting background symbol indexing...</span
					>
				</div>
				<br />
				<div>
					<span class="comment"># Search with symbol filtering</span>
				</div>
				<div>
					<span class="prompt">$</span>
					<span class="cmd">
						rfx query "resolve_thread_count" --kind function</span
					>
				</div>
				<div>
					<span class="output"
						>📁 src/models.rs (1 match)</span
					>
				</div>
				<div>
					<span class="output"
						>&nbsp;&nbsp;&nbsp;635 [fn] resolve_thread_count</span
					>
				</div>
				<div>
					<span class="output"
						>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;pub fn
						resolve_thread_count(configured: usize, auto_cap: usize)
						-&gt; usize {'{'}</span
					>
				</div>
				<div>
					<span class="output">Found 1 result in 6ms</span>
				</div>
				<br />
				<div>
					<span class="comment"># JSON output for AI pipelines</span>
				</div>
				<div>
					<span class="prompt">$</span>
					<span class="cmd">
						rfx query "resolve_thread_count" --symbols --json | jq
						'.results[0]'</span
					>
				</div>
				<div>
					<span class="output">{'{'}</span>
				</div>
				<div>
					<span class="output"
						>&nbsp;&nbsp;"path": "src/models.rs",</span
					>
				</div>
				<div>
					<span class="output"
						>&nbsp;&nbsp;"language": "rust",</span
					>
				</div>
				<div>
					<span class="output"
						>&nbsp;&nbsp;"matches": [{'{'}</span
					>
				</div>
				<div>
					<span class="output"
						>&nbsp;&nbsp;&nbsp;&nbsp;"kind": "Function",</span
					>
				</div>
				<div>
					<span class="output"
						>&nbsp;&nbsp;&nbsp;&nbsp;"symbol": "resolve_thread_count",</span
					>
				</div>
				<div>
					<span class="output"
						>&nbsp;&nbsp;&nbsp;&nbsp;"span": {'{'} "start_line": 635,
						"end_line": 643 {'}'},</span
					>
				</div>
				<div>
					<span class="output"
						>&nbsp;&nbsp;&nbsp;&nbsp;"preview": "pub fn
						resolve_thread_count(configured: usize, auto_cap: usize)
						-&gt; usize {'{'}\n …"</span
					>
				</div>
				<div>
					<span class="output">&nbsp;&nbsp;{'}'}]</span>
				</div>
				<div>
					<span class="output">{'}'}</span>
				</div>
			</div>
			</noscript>
		</section>

		<section class="install">
			<h2>Install</h2>
			<div class="install-methods">
				<div class="install-method">
					<span class="label">npm</span>
					<code>npm install -g reflex-search</code>
				</div>
				<div class="install-method">
					<span class="label">cargo</span>
					<code>cargo install reflex-search</code>
				</div>
				<div class="install-method">
					<span class="label">shell (Linux, macOS)</span>
					<code
						>curl --proto '=https' --tlsv1.2 -LsSf
						https://github.com/reflex-search/reflex/releases/latest/download/reflex-search-installer.sh
						| sh</code
					>
				</div>
				<div class="install-method">
					<span class="label">PowerShell (Windows)</span>
					<code
						>powershell -ExecutionPolicy Bypass -c "irm
						https://github.com/reflex-search/reflex/releases/latest/download/reflex-search-installer.ps1
						| iex"</code
					>
				</div>
			</div>
		</section>

		<footer>
			<div class="footer-links">
				<a href="/getting-started/">Documentation</a>
				<a href="https://github.com/reflex-search/reflex">GitHub</a>
			</div>
			<p>MIT OR Apache-2.0</p>
		</footer>
	</body>
</html>
