---
/**
 * AsciinemaPlayer — reusable terminal recording player.
 *
 * Uses data-* attributes to pass props to a client-side script that
 * calls AsciinemaPlayer.create(). Astro deduplicates the <script>
 * when multiple instances appear on the same page.
 */

interface Props {
	src: string;
	rows?: number;
	cols?: number;
	autoPlay?: boolean;
	loop?: boolean;
	speed?: number;
	idleTimeLimit?: number;
	poster?: string;
	fit?: 'width' | 'height' | 'both' | 'none';
	preload?: boolean;
	terminalFontSize?: string;
}

const {
	src,
	rows,
	cols,
	autoPlay = true,
	loop = false,
	speed = 1,
	idleTimeLimit,
	poster,
	fit = 'width',
	preload = true,
	terminalFontSize,
} = Astro.props;
---

<div
	class="asciinema-container"
	data-asciinema-player
	data-src={src}
	data-rows={rows}
	data-cols={cols}
	data-auto-play={autoPlay}
	data-loop={loop}
	data-speed={speed}
	data-idle-time-limit={idleTimeLimit}
	data-poster={poster}
	data-fit={fit}
	data-preload={preload}
	data-font-size={terminalFontSize}
></div>

<script>
	import * as AsciinemaPlayer from 'asciinema-player';

	function initPlayers() {
		document.querySelectorAll<HTMLElement>('[data-asciinema-player]').forEach((el) => {
			// Skip if already initialized
			if (el.dataset.initialized) return;
			el.dataset.initialized = 'true';

			const src = el.dataset.src;
			if (!src) return;

			const opts: Record<string, unknown> = {
				theme: 'reflex',
				fit: el.dataset.fit || 'width',
				terminalFontFamily:
					"'JetBrains Mono Variable', ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, monospace",
			};

			if (el.dataset.rows) opts.rows = Number(el.dataset.rows);
			if (el.dataset.cols) opts.cols = Number(el.dataset.cols);
			if (el.dataset.autoPlay === 'true') opts.autoPlay = true;
			if (el.dataset.loop === 'true') opts.loop = true;
			if (el.dataset.speed) opts.speed = Number(el.dataset.speed);
			if (el.dataset.idleTimeLimit) opts.idleTimeLimit = Number(el.dataset.idleTimeLimit);
			if (el.dataset.poster) opts.poster = el.dataset.poster;
			if (el.dataset.preload === 'true') opts.preload = true;
			if (el.dataset.fontSize) opts.terminalFontSize = el.dataset.fontSize;

			AsciinemaPlayer.create(src, el, opts);
		});
	}

	// Initialize on load and on Astro page transitions (view transitions)
	initPlayers();
	document.addEventListener('astro:page-load', initPlayers);
</script>
