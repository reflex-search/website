[79.88583, "o", "\u001b[?2026h\r\u001b[6A\u001b[38;2;255;255;255m●\u001b[1C\u001b[39m\u001b[1mArchitectural Overview of Reflex\u001b[22m             \r\u001b[2B  \u001b[1mProject Identity\u001b[22m                                                                                      \r\u001b[1B  \r\u001b[1B  Reflex is a \u001b[1mRust CLI tool with library API\u001b[22m — a local-first, trigram-based code search engine. It uses \r\u001b[2C\u001b[1B\u001b[1mclap\u001b[22m for CLI, \u001b[1maxum\u001b[22m for an optional HTTP/MCP server, and \u001b[1mtokio\u001b[1C\u001b[22mas\u001b[1Cits\u001b[1Casync\u001b[1Cruntime.\u001b[5C            \r\r\n\r\r\n\u001b[2C---\r\r\n\u001b[2C\u001b[1mProject\u001b[1CStructure\u001b[1C(5\u001b[1Cmajor\u001b[1Csubsystems)\u001b[22m\r\r\n\r\r\n\u001b[2C┌───────────────┬────────────────────────────────────────────────────┬─────────────────────────────┐\r\r\n\u001b[2C│\u001b[3CSubsystem\u001b[3C│\u001b[24CPath\u001b[24C│\u001b[11CPurpose\u001b[11C│\r\r\n\u001b[2C├───────────────┼────────────────────────────────────────────────────┼─────────────────────────────┤\r\r\n\u001b[2C│\u001b[1C\u001b[1mCore\u001b[1CSearch\u001b[3C\u001b[22m│\u001b[1C\u001b[38;2;177;185;249msrc/{trigram,query,indexer,cache,content_store}.rs\u001b[1C\u001b[39m│\u001b[1CTrigram\u001b[1Cindexing,\u001b[1Cfull-text\u001b[1C│\r\r\n\u001b[2C│\u001b[1C\u001b[1mEngine\u001b[8C\u001b[22m│\u001b[52C│\u001b[2Csearch,\u001b[1Ccontent\u001b[1Cstorage\u001b[4C│\r\r\n\u001b[2C├───────────────┼────────────────────────────────────────────────────┼─────────────────────────────┤\r\r\n\u001b[2C│\u001b[1C\u001b[1mParsers\u001b[7C\u001b[22m│\u001b[1C\u001b[38;2;177;185;249msrc/parsers/\u001b[1C\u001b[39m(17\u001b[1Cfiles,\u001b[1C~18K\u001b[1Clines)\u001b[16C│\u001b[1CTree-sitter-based\u001b[1Csymbol\u001b[4C│\r\r\n\u001b[2C│\u001b[15C│\u001b[52C│\u001b[1Cextraction\u001b[1Cfor\u001b[1C18\u001b[1Clanguages\u001b[1C│\r\r\n\u001b[2C├───────────────┼────────────────────────────────────────────────────┼─────────────────────────────┤\r\r\n\u001b[2C│\u001b[1C\u001b[1mSemantic/AI\u001b[3C\u001b[22m│\u001b[1C\u001b[38;2;177;185;249msrc/semantic/\u001b[1C\u001b[39m(19\u001b[1Cfiles)\u001b[27C│\u001b[1CLLM-powered\u001b[1C\u001b[38;2;177;185;249mrfx\u001b[1Cask\u001b[39m,\u001b[8C│\r\r\n\u001b[2C│\u001b[15C│\u001b[52C│\u001b[1Cagentic\u001b[1Cworkflows,\u001b[1Cchat\u001b[1CTUI\u001b[1C│\r\r\n\u001b[2C├───────────────┼────────────────────────────────────────────────────┼─────────────────────────────┤\r\r\n\u001b[2C│\u001b[15C│\u001b[52C│\u001b[1CDocumentation\u001b[1Csite\u001b[10C│\r\r\n\u001b[2C│\u001b[1C\u001b[1mPulse\u001b[9C\u001b[22m│\u001b[1C\u001b[38;2;177;185;249msrc/pulse/\u001b[1C\u001b[39m(16\u001b[1Cfiles)\u001b[30C│\u001b[1Cgeneration,\u001b[1Cchangelogs,\u001b[5C│\r\r\n\u001b[2C│\u001b[15C│\u001b[52C│\u001b[1Cwiki\u001b[24C│\r\r\n\u001b[2C├───────────────┼────────────────────────────────────────────────────┼─────────────────────────────┤\r\r\n\u001b[2C│\u001b[1C\u001b[1mInteractive\u001b[3C\u001b[22m│\u001b[1C\u001b[38;2;177;185;249msrc/interactive/\u001b[1C\u001b[39m(12\u001b[1Cfiles)\u001b[24C│\u001b[1CTerminal\u001b[1CUI\u001b[1Cfor\u001b[1Cinteractive\u001b[1C│\r\r\n\u001b[2C│\u001b[1C\u001b[1mTUI\u001b[11C\u001b[22m│\u001b[52C│\u001b[2Csearch\u001b[21C│\r\r\n\u001b[2C└───────────────┴────────────────────────────────────────────────────┴─────────────────────────────┘\r\r\n\r\r\n\u001b[2CSupporting\u001b[1Cmodules:\u001b[1C\u001b[38;2;177;185;249mcli.rs\u001b[1C\u001b[39m(4303\u001b[1Clines\u001b[1C—\u001b[1Cthe\u001b[1Clargest\u001b[1Cfile),\u001b[1C\u001b[38;2;177;185;249mdependency.rs\u001b[39m,\u001b[1C\u001b[38;2;177;185;249mmcp.rs\u001b[39m,\u001b[1C\u001b[38;2;177;185;249mmodels.rs\u001b[39m,\r\r\n\u001b[2C\u001b[38;2;177;185;249msymbol_cache.rs\u001b[39m.\r\r\n\r\r\n\u001b[2C---\r\r\n\u001b[2C\u001b[1mHottest\u001b[1CFiles\u001b[1C(most\u001b[1Cdepended-upon)\u001b[22m\r\r\n\r\r\n\u001b[2C┌────────────────────────────────┬────────────┬────────────────────────────────────────────────────┐\r\r\n\u001b[2C│\u001b[14CFile\u001b[14C│\u001b[1CDependents\u001b[1C│\u001b[24CRole\u001b[24C│\r\r\n\u001b[2C├────────────────────────────────┼────────────┼────────────────────────────────────────────────────┤\r\r\n\u001b[2C│\u001b[1C\u001b[38;2;177;185;249m\u001b[1msrc/models.rs\u001b[18C\u001b[22m\u001b[39m│\u001b[1C\u001b[1m33\u001b[9C\u001b[22m│\u001b[1CCentral\u001b[1Cdata\u001b[1Ctypes\u001b[1C—\u001b[1Cnearly\u001b[1Ceverything\u001b[1Cimports\u001b[5C│\r\r\n\u001b[2C│\u001b[32C│\u001b[12C│\u001b[1Cthis\u001b[47C│\r\r\n\u001b[2C├────────────────────────────────┼────────────┼────────────────────────────────────────────────────┤\r\r\n\u001b[2C│\u001b[1C\u001b[38;2;177;185;249m\u001b[1msrc/parsers/mod.rs\u001b[13C\u001b[22m\u001b[39m│\u001b[1C\u001b[1m16\u001b[9C\u001b[22m│\u001b[1CGrammar\u001b[1Cloader\u001b[1Chub\u001b[1C—\u001b[1Call\u001b[1C14\u001b[1Clanguage\u001b[1Cparsers\u001b[1C+\u001b[5C│\r\r\n\u001b[2C│\u001b[32C│\u001b[12C│\u001b[1Cconsumers\u001b[42C│\r\r\n\u001b[2C├────────────────────────────────┼────────────┼────────────────────────────────────────────────────┤\r\r\n\u001b[2C│\u001b[1C\u001b[38;2;177;185;249m\u001b[1msrc/query.rs\u001b[19C\u001b[22m\u001b[39m│\u001b[1C\u001b[1m6\u001b[10C\u001b[22m│\u001b[1CQuery\u001b[1Cengine\u001b[1C—\u001b[1Cused\u001b[1Cby\u001b[1CCLI,\u001b[1CMCP,\u001b[1Csemantic,\u001b[9C│\r\r\n\u001b[2C│\u001b[32C│\u001b[12C│\u001b[1Cinteractive\u001b[40C│\r\r\n\u001b[2C├────────────────────────────────┼────────────┼────────────────────────────────────────────────────┤\r\r\n\u001b[2C│\u001b[1C\u001b[38;2;177;185;249m\u001b[1msrc/semantic/schema_agentic.rs\u001b[1C\u001b[22m\u001b[39m│\u001b[1C\u001b[1m5\u001b[10C\u001b[22m│\u001b[1CAgentic\u001b[1Ctool\u001b[1Cschemas\u001b[31C│\r\r\n\u001b[2C├────────────────────────────────┼────────────┼────────────────────────────────────────────────────┤\r\r\n\u001b[2C│\u001b[1C\u001b[38;2;177;185;249m\u001b[1msrc/output.rs\u001b[18C\u001b[22m\u001b[39m│\u001b[1C\u001b[1m5\u001b[10C\u001b[22m│\u001b[1COutput\u001b[1Cformatting\u001b[1Cshared\u001b[1Cacross\u001b[1Cmodules\u001b[12C│\r\r\n\u001b[2C└────────────────────────────────┴────────────┴────────────────────────────────────────────────────┘\r\r\n\r\r\n\u001b[2C\u001b[38;2;177;185;249m★\u001b[1CInsight\u001b[1C─────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;2;177;185;249m\u001b[1mmodels.rs\u001b[39m at\u001b[1C33\u001b[1Cdependents\u001b[1Cis\u001b[1Cthe\u001b[1Cgravitational\u001b[1Ccenter\u001b[1C\u001b[22mof\u001b[1Cthis\u001b[1Ccodebase.\u001b[1CIt\u001b[1Cdefines\u001b[1Cthe\u001b[1Cshared\u001b[1Ctypes\r\r\n\u001b[2C(\u001b[38;2;177;185;249mSymbolDef\u001b[39m,\u001b[1C\u001b[38;2;177;185;249mSearchResult\u001b[39m,\u001b[1C\u001b[38;2;177;185;249mFileMatch\u001b[39m,\u001b[1Cetc.)\u001b[1Cthat\u001b[1Cevery\u001b[1Cmodule\u001b[1Cspeaks.\u001b[1CThis\u001b[1Cis\u001b[1Ca\u001b[1Cclassic\u001b[1C\"core\u001b[1Ctypes\"\r\r\n\u001b[2Cpattern\u001b[1Cin\u001b[1CRust\u001b[1C—\u001b[1Ca\u001b[1Csingle\u001b[1Cmodule\u001b[1Cre-exported\u001b[1Cvia\u001b[1C\u001b[38;2;177;185;249mlib.rs\u001b[1C\u001b[39mthat\u001b[1Cforms\u001b[1Cthe\u001b[1Clingua\u001b[1Cfranca.\u001b[1CThe\u001b[1Crisk:\r\r\n\u001b[2Cchanges\u001b[1Cto\u001b[1C\u001b[38;2;177;185;249mmodels.rs\u001b[1C\u001b[39mhave\u001b[1Ca\u001b[1Cblast\u001b[1Cradius\u001b[1Ctouching\u001b[1Cvirtually\u001b[1Cevery\u001b[1Cfile.\r\r\n\r\r\n\u001b[2C\u001b[38;2;177;185;249m\u001b[1mparsers/mod.rs\u001b[39m at\u001b[1C16\u001b[1Cdependents\u001b[1C\u001b[22macts\u001b[1Cas\u001b[1Ca\u001b[1Cfacade\u001b[1C—\u001b[1Cit\u001b[1Cre-exports\u001b[1Cthe\u001b[1Cunified\u001b[1C\u001b[38;2;177;185;249mextract_symbols()\u001b[1C\u001b[39mAPI\r\r\n\u001b[2Cwhile\u001b[1Ceach\u001b[1Clanguage\u001b[1Cparser\u001b[1C(rust.rs,\u001b[1Cpython.rs,\u001b[1Cetc.)\u001b[1Chandles\u001b[1Cits\u001b[1Cown\u001b[1Ctree-sitter\u001b[1Cgrammar.\u001b[1CThis\u001b[1Cis\u001b[1Ca\r\r\n\u001b[2Ctextbook\u001b[1C\"strategy\u001b[1Cpattern\"\u001b[1Cin\u001b[1CRust\u001b[1Cusing\u001b[1Cmodules\u001b[1Cinstead\u001b[1Cof\u001b[1Ctrait\u001b[1Cobjects.\r\r\n\u001b[2C\u001b[38;2;177;185;249m─────────────────────────────────────────────────\u001b[39m\r\r\n\r\r\n\u001b[2C---\r\r\n\u001b[2C\u001b[1mCircular\u001b[1CDependencies\u001b[1C(15\u001b[1Ctotal)\u001b[22m\r\r\n\r\r\n\u001b[2CAll\u001b[1C15\u001b[1Ccycles\u001b[1Cfall\u001b[1Cinto\u001b[1C\u001b[1mtwo\u001b[1Ccategories\u001b[22m:\r\r\n\r\r\n\u001b[2C\u001b[1m1.\u001b[1CParser\u001b[1Cmodule\u001b[1Ccycles\u001b[1C(14\u001b[1Cof\u001b[1C15):\u001b[22m\r\r\n\u001b[2Csrc/parsers/mod.rs\u001b[1C⇄\u001b[1Csrc/parsers/{rust,typescript,python,go,...}.rs\r\r\n\u001b[2CEach\u001b[1Clanguage\u001b[1Cparser\u001b[1Cimports\u001b[1Cfrom\u001b[1C\u001b[38;2;177;185;249mmod.rs\u001b[1C\u001b[39m(shared\u001b[1Chelpers/types),\u001b[1Cand\u001b[1C\u001b[38;2;177;185;249mmod.rs\u001b[1C\u001b[39mimports\u001b[1Ceach\u001b[1Cparser\u001b[1Cto\r\r\n\u001b[2Cdispatch.\u001b[1CThis\u001b[1Cis\u001b[1C\u001b[1mnormal\u001b[1Cand\u001b[1Cexpected\u001b[1C\u001b[22mfor\u001b[1CRust's\u001b[1Cmodule\u001b[1Csystem\u001b[1C—\u001b[1C\u001b[38;2;177;185;249mmod.rs\u001b[1C\u001b[39mdeclares\u001b[1C\u001b[38;2;177;185;249mmod\u001b[1Crust;\u001b[1C\u001b[39mwhich\r\r\n\u001b[2Ccreates\u001b[1Ca\u001b[1Cbidirectional\u001b[1Crelationship.\u001b[1CThese\u001b[1Caren't\u001b[1Creal\u001b[1Carchitectural\u001b[1Cproblems.\r\r\n\r\r\n\u001b[2C\u001b[1m2.\u001b[1CInteractive\u001b[1CTUI\u001b[1Ccycle\u001b[1C(1):\u001b[22m\r\r\n\u001b[2Csrc/interactive/app.rs\u001b[1C⇄\u001b[1Csrc/interactive/ui.rs\r\r\n\u001b[2CThe\u001b[1Capp\u001b[1Cstate\u001b[1Cand\u001b[1CUI\u001b[1Crendering\u001b[1Creference\u001b[1Ceach\u001b[1Cother.\u001b[1CAlso\u001b[1Ctypical\u001b[1Cfor\u001b[1CTUI\u001b[1Carchitectures\u001b[1Cwhere\u001b[1Cthe\u001b[1Capp\r\r\n\u001b[2Cstruct\u001b[1Cdrives\u001b[1Crendering\u001b[1Cand\u001b[1CUI\u001b[1Cevents\u001b[1Cfeed\u001b[1Cback\u001b[1Cinto\u001b[1Cthe\u001b[1Capp.\r\r\n\r\r\n\u001b[2C\u001b[38;2;177;185;249m★\u001b[1CInsight\u001b[1C─────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[1mNone\u001b[1Cof\u001b[1Cthese\u001b[1Ccycles\u001b[1Care\u001b[1Cproblematic.\u001b[1C\u001b[22mIn\u001b[1CRust,\u001b[1C\u001b[38;2;177;185;249mmod.rs\u001b[1C⇄\u001b[1Cchild.rs\u001b[1C\u001b[39mcycles\u001b[1Care\u001b[1Can\u001b[1Cartifact\u001b[1Cof\u001b[1Cthe\u001b[1Cmodule\r\r\n\u001b[2Csystem,\u001b[1Cnot\u001b[1Can\u001b[1Carchitectural\u001b[1Csmell.\u001b[1CThe\u001b[1Cparent\u001b[1Cdeclares\u001b[1C\u001b[38;2;177;185;249mmod\u001b[1Cchild;\u001b[1C\u001b[39m(creating\u001b[1Ca\u001b[1Cdependency)\u001b[1Cand\u001b[1Cthe\r\r\n\u001b[2Cchild\u001b[1Cuses\u001b[1C\u001b[38;2;177;185;249msuper::\u001b[1C\u001b[39mor\u001b[1C\u001b[38;2;177;185;249mcrate::\u001b[1C\u001b[39mto\u001b[1Caccess\u001b[1Cshared\u001b[1Citems.\u001b[1CUnlike\u001b[1Clanguages\u001b[1Clike\u001b[1CPython\u001b[1Cor\u001b[1CTypeScript\u001b[1Cwhere\r\r\n\u001b[3Ccircular\u001b[1Cimports\u001b[1Ccan\u001b[1Ccause\u001b[1Cruntime\u001b[1Cfailures,\u001b[1CRust's\u001b[1Cmodule\u001b[1Csystem\u001b[1Chandles\u001b[1Cthis\u001b[1Cat\u001b[1Ccompile\u001b[1Ctime.\u001b[1CThe\r\r\n\u001b[2Cdependency\u001b[1Canalyzer\u001b[1Cis\u001b[1Ccorrectly\u001b[1Cidentifying\u001b[1Cthe\u001b[1Crelationship,\u001b[1Cbut\u001b[1Cit's\u001b[1Cinherent\u001b[1Cto\u001b[1Chow\u001b[1CRust\u001b[1Cmodules\r\r\n\u001b[2Cwork.\r\r\n\u001b[2C\u001b[38;2;177;185;249m─────────────────────────────────────────────────\u001b[39m\r\r\n\r\r\n\u001b[2C---\r\r\n\u001b[2C\u001b[1mKey\u001b[1CMetrics\u001b[22m\r\r\n\r\r\n\u001b[2C┌──────────────────────────┬───────┬────────────────────────────────────────────────────┐\r\r\n\u001b[2C│\u001b[10CMetric\u001b[10C│\u001b[1CCount\u001b[1C│\u001b[21CAssessment\u001b[21C│\r\r\n\u001b[2C├──────────────────────────┼───────┼────────────────────────────────────────────────────┤\r\r\n\u001b[2C│\u001b[1CTotal\u001b[1Csource\u001b[1Cfiles\u001b[7C│\u001b[1C167\u001b[3C│\u001b[1CMedium-sized\u001b[1Ccodebase\u001b[30C│\r\r\n\u001b[2C├──────────────────────────┼───────┼────────────────────────────────────────────────────┤\r\r\n\u001b[2C│\u001b[1CHotspots\u001b[1C(2+\u001b[1Cdependents)\u001b[1C│\u001b[1C32\u001b[4C│\u001b[1CWell-distributed\u001b[35C│\r\r\n\u001b[2C├──────────────────────────┼───────┼────────────────────────────────────────────────────┤\r\r\n\u001b[2C│\u001b[1CCircular\u001b[1Cdependencies\u001b[4C│\u001b[1C15\u001b[4C│\u001b[1CAll\u001b[1Cbenign\u001b[1C(Rust\u001b[1Cmodule\u001b[1Cpattern)\u001b[19C│\r\r\n\u001b[2C├──────────────────────────┼───────┼────────────────────────────────────────────────────┤\r\r\n\u001b[2C│\u001b[1CUnused/orphan\u001b[1Cfiles\u001b[6C│\u001b[1C82\u001b[4C│\u001b[1CMostly\u001b[1Ctest\u001b[1Ccorpus\u001b[1Cfiles,\u001b[1Centry\u001b[1Cpoints,\u001b[1Cand\u001b[1Cconfig\u001b[1C│\r\r\n\u001b[2C├──────────────────────────┼───────┼────────────────────────────────────────────────────┤\r\r\n\u001b[2C│\u001b[1CDisconnected\u001b[1Cislands\u001b[5C│\u001b[1C81\u001b[4C│\u001b[1CExpected\u001b[1C—\u001b[1Ctest\u001b[1Ccorpus\u001b[1Cfiles\u001b[1C+\u001b[1Clanguage\u001b[1Csamples\u001b[4C│\r\r\n\u001b[2C└──────────────────────────┴───────┴────────────────────────────────────────────────────┘\r\r\n\r\r\n\u001b[2C---\r\r\n\u001b[2C\u001b[1mData\u001b[1CFlow\u001b[22m\r\r\n\r\r\n\u001b[2CUser\u001b[1CQuery\r\r\n\u001b[6C│\r\r\n\u001b[6C▼\r\r\n\u001b[4Ccli.rs\u001b[1C(4303\u001b[1Clines\u001b[1C—\u001b[1Ccommand\u001b[1Cdispatch)\r\r\n\u001b[6C│\r\r\n\u001b[6C├──▶\u001b[1Cindexer.rs\u001b[1C→\u001b[1Ctrigram.rs\u001b[1C→\u001b[1Ccache.rs\u001b[1C→\u001b[1Ccontent_store.rs\r\r\n\u001b[6C│\u001b[9C(build\u001b[1Cindex)\u001b[10C(SQLite\u001b[1C+\u001b[1Cbinary\u001b[1Cfiles)\r\r\n\u001b[6C│\r\r\n\u001b[6C├──▶\u001b[1Cquery.rs\u001b[1C→\u001b[1Ctrigram.rs\u001b[1C(posting\u001b[1Clist\u001b[1Cintersection)\r\r\n\u001b[6C│\u001b[7C│\r\r\n\u001b[6C│\u001b[7C└──▶\u001b[1Cparsers/mod.rs\u001b[1C→\u001b[1C{rust,python,...}.rs\u001b[2C(symbol\u001b[1Cfiltering)\r\r\n\u001b[6C│\r\r\n\u001b[6C├──▶\u001b[1Cmcp.rs\u001b[1C(MCP\u001b[1Cserver\u001b[1Cprotocol)\r\r\n\u001b[6C├──▶\u001b[1Csemantic/\u001b[1C(LLM-powered\u001b[1Cask)\r\r\n\u001b[6C└──▶\u001b[1Cinteractive/\u001b[1C(TUI\u001b[1Csearch)\r\r\n\r\r\n\u001b[2CThe\u001b[1Carchitecture\u001b[1Cfollows\u001b[1Ca\u001b[1Cclean\u001b[1C\u001b[1mfunnel\u001b[1Cpattern\u001b[22m:\u001b[1C\u001b[38;2;177;185;249mcli.rs\u001b[1C\u001b[39mdispatches\u001b[1Cto\u001b[1Csubsystems,\u001b[1C\u001b[38;2;177;185;249mmodels.rs\u001b[1C\u001b[39mprovides\r\r\n\u001b[2Cthe\u001b[1Cshared\u001b[1Cvocabulary,\u001b[1Cand\u001b[1C\u001b[38;2;177;185;249mparsers/mod.rs\u001b[1C\u001b[39mprovides\u001b[1Cthe\u001b[1Cunified\u001b[1Cparsing\u001b[1Cfacade.\u001b[1CThe\u001b[1Cheaviest\u001b[1Clogic\r\r\n\u001b[2Clives\u001b[1Cin\u001b[1C\u001b[38;2;177;185;249mquery.rs\u001b[1C\u001b[39m(3220\u001b[1Clines)\u001b[1Cand\u001b[1C\u001b[38;2;177;185;249mcli.rs\u001b[1C\u001b[39m(4303\u001b[1Clines)\u001b[1C—\u001b[1Cthose\u001b[1Cwould\u001b[1Cbe\u001b[1Cthe\u001b[1Cfirst\u001b[1Ccandidates\u001b[1Cif\u001b[1Cyou\r\r\n\u001b[2Cever\u001b[1Cneed\u001b[1Cto\u001b[1Csplit\u001b[1Cmodules.\r\r\n\r\r\n\u001b[38;2;215;119;87m✽\u001b[1CCerebrating…\u001b[1C\u001b[38;2;153;153;153m(43s\u001b[1C·\u001b[1C↓\u001b[1C1.3k\u001b[1Ctokens\u001b[1C·\u001b[1C\u001b[38;2;158;158;158mthinking\u001b[38;2;153;153;153m)\u001b[39m\r\r\n\r\r\n\u001b[2m\u001b[38;2;136;136;136m────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\u001b[22m\r\r\n\u001b[38;2;153;153;153m❯ \u001b[39m\r\r\n\u001b[2m\u001b[38;2;136;136;136m────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\u001b[22m\r\r\n\u001b[2C\u001b[38;2;153;153;153m\u001b[2muser@name\u001