[27.388459, "o", "\r\n\u001b[36m\u001b[1mGenerated Queries:\u001b[0m\u001b[39m\r\n\u001b[36m==================\u001b[39m\r\n\u001b[1m\u001b[97m1\u001b[39m\u001b[0m. \u001b[2m[order: 1, merge: true]\u001b[0m \u001b[1m\u001b[92mrfx\u001b[39m\u001b[0m \u001b[97mquery \"trigram\"\u001b[39m\r\n\r\n\r\n\u001b[1m\u001b[92mFound\u001b[39m\u001b[0m \u001b[1m\u001b[97m185\u001b[39m\u001b[0m \u001b[2mtotal results across\u001b[0m \u001b[1m\u001b[97m16\u001b[39m\u001b[0m \u001b[2mfiles:\u001b[0m\r\n\r\n\u001b[1m\u001b[96m./build.rs\u001b[39m\u001b[0m:\r\n  \u001b[2mLine\u001b[0m \u001b[93m15\u001b[39m-\u001b[93m15\u001b[39m: //! - src/trigram.rs: Inverted index format for trigrams.bin (posting lists)\r\n  \u001b[2mLine\u001b[0m \u001b[93m31\u001b[39m-\u001b[93m31\u001b[39m:     \"src/trigram.rs\",\r\n\r\n\u001b[1m\u001b[96m./src/ast_query.rs\u001b[39m\u001b[0m:\r\n  \u001b[2mLine\u001b[0m \u001b[93m15\u001b[39m-\u001b[93m15\u001b[39m: //! - Requires trigram pre-filtering (no AST-only queries allowed)\r\n  \u001b[2mLine\u001b[0m \u001b[93m27\u001b[39m-\u001b[93m27\u001b[39m: //! // Prepare candidates from trigram search\r\n  \u001b[2mLine\u001b[0m \u001b[93m57\u001b[39m-\u001b[93m57\u001b[39m: /// Takes a list of candidate files (from Phase 1 trigram/regex search),\r\n  \u001b[2mLine\u001b[0m \u001b[93m304\u001b[39m-\u001b[93m304\u001b[39m:         // Create dummy candidates (trigram pre-filtering would have found these)\r\n\r\n\u001b[1m\u001b[96m./src/cli.rs\u001b[39m\u001b[0m:\r\n  \u001b[2mLine\u001b[0m \u001b[93m130\u001b[39m-\u001b[93m130\u001b[39m:         /// WARNING: AST queries bypass trigram optimization and scan the entire codebase.\r\n\r\n\u001b[1m\u001b[96m./src/content_store.rs\u001b[39m\u001b[0m:\r\n  \u001b[2mLine\u001b[0m \u001b[93m5\u001b[39m-\u001b[93m5\u001b[39m: //! - Verifying trigram matches\r\n\r\n\u001b[1m\u001b[96m./src/indexer.rs\u001b[39m\u001b[0m:\r\n  \u001b[2mLine\u001b[0m \u001b[93m36\u001b[39m-\u001b[93m36\u001b[39m: use crate::trigram::TrigramIndex;\r\n  \u001b[2mLine\u001b[0m \u001b[93m253\u001b[39m-\u001b[93m253\u001b[39m:         // Step 2: Build trigram index + content store\r\n  \u001b[2mLine\u001b[0m \u001b[93m260\u001b[39m-\u001b[93m260\u001b[39m:         // Initialize trigram index and content store\r\n  \u001b[2mLine\u001b[0m \u001b[93m264\u001b[39m-\u001b[93m264\u001b[39m:         // Enable batch-flush mode for trigram index if we have lots of files\r\n  \u001b[2mLine\u001b[0m \u001b[93m268\u001b[39m-\u001b[93m268\u001b[39m:                 .context(\"Failed to enable batch-flush mode for trigram index\")?;\r\n  \u001b[2mLine\u001b[0m \u001b[93m568\u001b[39m-\u001b[93m568\u001b[39m:                 // Add file to trigram index (get file_id)\r\n  \u001b[2mLine\u001b[0m \u001b[93m600\u001b[39m-\u001b[93m600\u001b[39m:             // Flush trigram index batch to disk if batch-flush mode is enabled\r\n  \u001b[2mLine\u001b[0m \u001b[93m608\u001b[39m-\u001b[93m608\u001b[39m:                     .context(\"Failed to flush trigram batch\")?;\r\n  \u001b[2mLine\u001b[0m \u001b[93m623\u001b[39m-\u001b[93m623\u001b[39m:         // Finalize trigram index (sort and deduplicate posting lists)\r\n  \u001b[2mLine\u001b[0m \u001b[93m624\u001b[39m-\u001b[93m624\u001b[39m:         *progress_status.lock().unwrap() = \"Finalizing trigram index...\".to_string();\r\n  \u001b[2mLine\u001b[0m \u001b[93m626\u001b[39m-\u001b[93m626\u001b[39m:             pb.set_message(\"Finalizing trigram index...\".to_string());\r\n  \u001b[2mLine\u001b[0m \u001b[93m1496\u001b[39m-\u001b[93m1496\u001b[39m:         // Step 3: Write trigram index\r\n  \u001b[2mLine\u001b[0m \u001b[93m1497\u001b[39m-\u001b[93m1497\u001b[39m:         *progress_status.lock().unwrap() = \"Writing trigram index...\".to_string();\r\n  \u001b[2mLine\u001b[0m \u001b[93m1499\u001b[39m-\u001b[93m1499\u001b[39m:             pb.set_message(\"Writing trigram index...\".to_string());\r\n"]
[27.388807, "o", "  \u001b[2mLine\u001b[0m \u001b[93m1502\u001b[39m-\u001b[93m1502\u001b[39m:         log::info!(\"Writing trigram index with {} trigrams to trigrams.bin\",\r\n  \u001b[2mLine\u001b[0m \u001b[93m1506\u001b[39m-\u001b[93m1506\u001b[39m:             .context(\"Failed to write trigram index\")?;\r\n\r\n\u001b[1m\u001b[96m./src/lib.rs\u001b[39m\u001b[0m:\r\n  \u001b[2mLine\u001b[0m \u001b[93m10\u001b[39m-\u001b[93m10\u001b[39m: //! - **Indexer**: Scans code and builds trigram index; writes to cache\r\n  \u001b[2mLine\u001b[0m \u001b[93m49\u001b[39m-\u001b[93m49\u001b[39m: pub mod trigram;\r\n\r\n\u001b[1m\u001b[96m./src/mcp.rs\u001b[39m\u001b[0m:\r\n  \u001b[2mLine\u001b[0m \u001b[93m303\u001b[39m-\u001b[93m303\u001b[39m:                 \"description\": \"⚠️ ADVANCED USERS ONLY - DO NOT USE UNLESS ABSOLUTELY NECESSARY ⚠️\\n\\nStructure-aware code search using Tree-sitter AST patterns (S-expressions).\\n\\n**PERFORMANCE WARNING:** AST queries bypass trigram optimization and scan the ENTIRE codebase (500ms-10s+).\\n\\n**WHEN TO USE (RARE):**\\n- You need to match code structure, not just text (e.g., \\\"all async functions with try/catch blocks\\\")\\n- --symbols search is insufficient (e.g., need to match specific AST node types)\\n- You have a very specific structural pattern that cannot be expressed as text\\n\\n**IN 95% OF CASES, USE search_code with symbols=true INSTEAD** (10-100x faster).\\n\\n**REQUIRED:** You MUST use glob patterns to limit scope (e.g., glob=['src/**/*.rs']) to avoid scanning thousands of files.\\n\\n**Token efficiency:** Previews are auto-truncated to ~100 chars. Use limit parameter to control result count.\\n\\n**Error Handling:** If you receive an error message containing \\\"Index not found\\\" or \\\"stale\\\", immediately call the index_project tool, wait for it to complete, then retry this operation.\\n\\n**Example AST patterns:**\\n- Rust: '(function_item) @fn' (all functions)\\n- Python: '(function_definition) @fn' (all functions)\\n- TypeScript: '(class_declaration) @class' (all classes)\\n\\nRefer to Tree-sitter documentation for each language's grammar.\",\r\n  \u001b[2mLine\u001b[0m \u001b[93m982\u001b[39m-\u001b[93m982\u001b[39m:             // Use the new search_ast_all_files method (no trigram filtering)\r\n\r\n\u001b[1m\u001b[96m./src/pulse/wiki.rs\u001b[39m\u001b[0m:\r\n  \u001b[2mLine\u001b[0m \u001b[93m1226\u001b[39m-\u001b[93m1226\u001b[39m:     // Count references for priority-kind symbols only via the trigram index.\r\n\r\n\u001b[1m\u001b[96m./src/query.rs\u001b[39m\u001b[0m:\r\n  \u001b[2mLine\u001b[0m \u001b[93m18\u001b[39m-\u001b[93m18\u001b[39m: use crate::trigram::TrigramIndex;\r\n  \u001b[2mLine\u001b[0m \u001b[93m390\u001b[39m-\u001b[93m390\u001b[39m:         // not just the first 100 candidates from trigram search.\r\n  \u001b[2mLine\u001b[0m \u001b[93m415\u001b[39m-\u001b[93m415\u001b[39m:         // This check happens BEFORE the expensive trigram search to prevent hangs on large indexes\r\n  \u001b[2mLine\u001b[0m \u001b[93m422\u001b[39m-\u001b[93m422\u001b[39m:         // 3. Not using regex (regex has its own trigram extraction) AND\r\n  \u001b[2mLine\u001b[0m \u001b[93m469\u001b[39m-\u001b[93m469\u001b[39m:             // This ensures we find ALL classes/functions/etc, not just those in the first 100 trigram matches\r\n  \u001b[2mLine\u001b[0m \u001b[93m471\u001b[39m-\u001b[93m471\u001b[39m:                 log::info!(\"Keyword query detected for '{}' - scanning all {:?} files (bypassing trigram search)\",\r\n  \u001b[2mLine\u001b[0m \u001b[93m474\u001b[39m-\u001b[93m474\u001b[39m:                 log::info!(\"Keyword query detected for '{}' - scanning all files (bypassing trigram search)\", pattern);\r\n  \u001b[2mLine\u001b[0m \u001b[93m478\u001b[39m-\u001b[93m478\u001b[39m:             // Regex pattern search with trigram optimization\r\n  \u001b[2mLine\u001b[0m \u001b[93m481\u001b[39m-\u001b[93m481\u001b[39m:             // Standard trigram-based full-text search\r\n  \u001b[2mLine\u001b[0m \u001b[93m612\u001b[39m-\u001b[93m612\u001b[39m:             // Condition 1: Pattern too short (< 3 chars can't use trigram optimization efficiently)\r\n  \u001b[2mLine\u001b[0m \u001b[93m625\u001b[39m-\u001b[93m625\u001b[39m:             // - Trigram-filtered symbols: 50,000 files (~5 seconds max) - very fast due to trigram filtering\r\n  \u001b[2mLine\u001b[0m \u001b[93m641\u001b[39m-\u001b[93m641\u001b[39m:                     format!(\"Pattern '{}' is too short ({} characters). Short patterns bypass trigram optimization and require scanning many files.\", pattern, pattern_len)\r\n  \u001b[2mLine\u001b[0m \u001b[93m861\u001b[39m-\u001b[93m861\u001b[39m:     /// Execute AST query on all indexed files (no trigram filtering)\r\n  \u001b[2mLine\u001b[0m \u001b[93m874\u001b[39m-\u001b[93m874\u001b[39m:     /// - Parses entire codebase (not just trigram candidates)\r\n  \u001b[2mLine\u001b[0m \u001b[93m1094\u001b[39m-\u001b[93m1094\u001b[39m:     /// Search using AST pattern with separate text pattern for trigram filtering\r\n  \u001b[2mLine\u001b[0m \u001b[93m1097\u001b[39m-\u001b[93m1097\u001b[39m:     /// 1. Using text_pattern for Phase 1 trigram filtering (narrows to candidate files)\r\n  \u001b[2mLine\u001b[0m \u001b[93m1102\u001b[39m-\u001b[93m1102\u001b[39m:     /// // Find async functions: trigram search for \"fn \", AST match for function_item\r\n  \u001b[2mLine\u001b[0m \u001b[93m1133\u001b[39m-\u001b[93m1133\u001b[39m:         // PHASE 1: Get initial candidates using text pattern (trigram search)\r\n  \u001b[2mLine\u001b[0m \u001b[93m1294\u001b[39m-\u001b[93m1294\u001b[39m:         // Load trigram index for file path lookups\r\n  \u001b[2mLine\u001b[0m \u001b[93m1684\u001b[39m-\u001b[93m1684\u001b[39m:         // Load trigram index for file path lookups\r\n  \u001b[2mLine\u001b[0m \u001b[93m1738\u001b[39m-\u001b[93m1738\u001b[39m:         // Try trigram index first (faster)\r\n  \u001b[2mLine\u001b[0m \u001b[93m1798\u001b[39m-\u001b[93m1798\u001b[39m:     /// This method bypasses trigram search and returns ALL files of the specified language.\r\n  \u001b[2mLine\u001b[0m \u001b[93m1800\u001b[39m-\u001b[93m1800\u001b[39m:     /// not just the first 100 candidates from a trigram search.\r\n  \u001b[2mLine\u001b[0m \u001b[93m1902\u001b[39m-\u001b[93m1902\u001b[39m:     /// Get candidate results using trigram-based full-text search\r\n  \u001b[2mLine\u001b[0m \u001b[93m1909\u001b[39m-\u001b[93m1909\u001b[39m:         // Load trigram index from disk (or rebuild if missing)\r\n  \u001b[2mLine\u001b[0m \u001b[93m1914\u001b[39m-\u001b[93m1914\u001b[39m:                     log::debug!(\"Loaded trigram index from disk: {} trigrams, {} files\",\r\n  \u001b[2mLine\u001b[0m \u001b[93m1919\u001b[39m-\u001b[93m1919\u001b[39m:                     log::warn!(\"Failed to load trigram index from disk: {}\", e);\r\n  \u001b[2mLine\u001b[0m \u001b[93m1920\u001b[39m-\u001b[93m1920\u001b[39m:                     log::warn!(\"Rebuilding trigram index from content store...\");\r\n  \u001b[2mLine\u001b[0m \u001b[93m1931\u001b[39m-\u001b[93m1931\u001b[39m:         log::debug!(\"Found {} candidate locations from trigram search\", candidates.len());\r\n  \u001b[2mLine\u001b[0m \u001b[93m1951\u001b[39m-\u001b[93m1951\u001b[39m:         let mut candidates_by_file: HashMap<u32, Vec<crate::trigram::FileLocation>> = HashMap::new();\r\n  \u001b[2mLine\u001b[0m \u001b[93m1959\u001b[39m-\u001b[93m1959\u001b[39m:         log::debug!(\"Scanning {} files with trigram matches\", candidates_by_file.len());\r\n  \u001b[2mLine\u001b[0m \u001b[93m1993\u001b[39m-\u001b[93m1993\u001b[39m:                 // Only check the specific lines indicated by trigram posting lists\r\n  \u001b[2mLine\u001b[0m \u001b[93m2056\u001b[39m-\u001b[93m2056\u001b[39m:     /// Get candidate results using regex patterns with trigram optimization\r\n  \u001b[2mLine\u001b[0m \u001b[93m2076\u001b[39m-\u001b[93m2076\u001b[39m:     /// - Best case (pattern with literals): <20ms (trigram optimization)\r\n  \u001b[2mLine\u001b[0m \u001b[93m2130\u001b[39m-\u001b[93m2130\u001b[39m:             // Load trigram index\r\n  \u001b[2mLine\u001b[0m \u001b[93m2160\u001b[39m-\u001b[93m2160\u001b[39m:                     // Search for this literal in the trigram index\r\n  \u001b[2mLine\u001b[0m \u001b[93m2177\u001b[39m-\u001b[93m2177\u001b[39m:                         .context(\"Invalid file_id from trigram search\")?;\r\n  \u001b[2mLine\u001b[0m \u001b[93m2251\u001b[39m-\u001b[93m2251\u001b[39m:     /// Rebuild trigram index from content store (fallback when trigrams.bin is missing)\r\n  \u001b[2mLine\u001b[0m \u001b[93m2253\u001b[39m-\u001b[93m2253\u001b[39m:         log::debug!(\"Rebuilding trigram index from {} files\", content_reader.file_count());\r\n\r\n\u001b[1m\u001b[96m./src/regex_trigrams.rs\u001b[39m\u001b[0m:\r\n  \u001b[2mLine\u001b[0m \u001b[93m1\u001b[39m-\u001b[93m1\u001b[39m: //! Extract literal sequences from regex patterns for trigram optimization\r\n  \u001b[2mLine\u001b[0m \u001b[93m4\u001b[39m-\u001b[93m4\u001b[39m: //! fast regex search using the trigram index. The key insight is that many regex\r\n  \u001b[2mLine\u001b[0m \u001b[93m36\u001b[39m-\u001b[93m36\u001b[39m: use crate::trigram::{extract_trigrams, Trigram};\r\n  \u001b[2mLine\u001b[0m \u001b[93m272\u001b[39m-\u001b[93m272\u001b[39m:         log::debug!(\"Case-insensitive flag detected in pattern, cannot use trigram optimization\");\r\n\r\n\u001b[1m\u001b[96m./src/semantic/mod.rs\u001b[39m\u001b[0m:\r\n  \u001b[2mLine\u001b[0m \u001b[93m494\u001b[39m-\u001b[93m494\u001b[39m:       \"query\": \"trigram\",\r\n  \u001b[2mLine\u001b[0m \u001b[93m512\u001b[39m-\u001b[93m512\u001b[39m:         assert_eq!(value[\"tool_calls\"][0][\"query\"], serde_json::json!(\"trigram\"));\r\n\r\n\u001b[1m\u001b[96m./src/trigram.rs\u001b[39m\u001b[0m:\r\n  \u001b[2mLine\u001b[0m \u001b[93m3\u001b[39m-\u001b[93m3\u001b[39m: //! This module implements the core trigram indexing algorithm used by Reflex.\r\n  \u001b[2mLine\u001b[0m \u001b[93m4\u001b[39m-\u001b[93m4\u001b[39m: //! A trigram is a sequence of 3 consecutive bytes. By building an inverted index\r\n  \u001b[2mLine\u001b[0m \u001b[93m23\u001b[39m-\u001b[93m23\u001b[39m: /// A trigram is 3 consecutive bytes, packed into a u32 for efficient hashing\r\n  \u001b[2mLine\u001b[0m \u001b[93m144\u001b[39m-\u001b[93m144\u001b[39m: /// Location of a trigram occurrence in the codebase\r\n  \u001b[2mLine\u001b[0m \u001b[93m165\u001b[39m-\u001b[93m165\u001b[39m: /// Serializable trigram data (for rkyv zero-copy serialization)\r\n  \u001b[2mLine\u001b[0m \u001b[93m168\u001b[39m-\u001b[93m168\u001b[39m:     /// Inverted index: trigram → sorted locations\r\n  \u001b[2mLine\u001b[0m \u001b[93m174\u001b[39m-\u001b[93m174\u001b[39m: /// Directory entry for lazy-loaded trigram index\r\n  \u001b[2mLine\u001b[0m \u001b[93m176\u001b[39m-\u001b[93m176\u001b[39m: /// Maps each trigram to its compressed posting list location in the data section.\r\n  \u001b[2mLine\u001b[0m \u001b[93m180\u001b[39m-\u001b[93m180\u001b[39m:     /// The trigram value (for binary search)\r\n  \u001b[2mLine\u001b[0m \u001b[93m181\u001b[39m-\u001b[93m181\u001b[39m:     trigram: Trigram,\r\n  \u001b[2mLine\u001b[0m \u001b[93m190\u001b[39m-\u001b[93m190\u001b[39m: /// Maps each trigram to a sorted list of locations where it appears.\r\n  \u001b[2mLine\u001b[0m \u001b[93m192\u001b[39m-\u001b[93m192\u001b[39m: /// The index itself is kept sorted by trigram for O(log n) binary search.\r\n  \u001b[2mLine\u001b[0m \u001b[93m199\u001b[39m-\u001b[93m199\u001b[39m:     /// Inverted index: sorted Vec of (trigram, locations) for binary search\r\n  \u001b[2mLine\u001b[0m \u001b[93m208\u001b[39m-\u001b[93m208\u001b[39m:     /// Directory of (trigram, offset, size) for lazy loading\r\n  \u001b[2mLine\u001b[0m \u001b[93m217\u001b[39m-\u001b[93m217\u001b[39m:     /// Create a new empty trigram index\r\n  \u001b[2mLine\u001b[0m \u001b[93