[64.075761, "o", "\u001b[?25l\u001b[2D\u001b[3B\r\u001b[2C\u001b[5AThere\u001b[9Gis\u001b[12G\u001b[1mone cycle\u001b[22m:\u001b[23G\u001b[38;5;153msrc/interactive/app.rs\u001b[46G\u001b[39m↔\u001b[48G\u001b[38;5;153msrc/interactive/ui.rs\u001b[39m.\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;5;153mapp.rs\u001b[10G\u001b[39mimports\u001b[18G\u001b[38;5;153msuper::ui\u001b[28G\u001b[39mto\u001b[31Gcall\u001b[36Gthe\u001b[40Grender\u001b[47Gfunctions,\u001b[58Gand\u001b[62G\u001b[38;5;153mui.rs\u001b[68G\u001b[39mimports\u001b[76G\u001b[38;5;153mAppMode\u001b[39m,\u001b[85G\u001b[38;5;153mFocusState\u001b[39m,\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;5;246m❯ \u001b[39m\r\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[3G\u001b[38;5;220m⏵⏵\u001b[6Gauto\u001b[11Gmode\u001b[16Gon\u001b[38;5;246m (shift+tab\u001b[30Gto\u001b[33Gcycle)\u001b[40G·\u001b[42Gesc\u001b[46Gto\u001b[49Ginterrupt\u001b[59G·\u001b[61G←\u001b[63Gfor\u001b[67Gagents\u001b[91G61336\u001b[97Gtokens\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?25h"]
[64.665541, "o", "\u001b[?25l\u001b[2D\u001b[3B\r\u001b[2C\u001b[5A\u001b[38;5;153mIndexStatusState\u001b[20G\u001b[39mand\u001b[24G\u001b[38;5;153mInteractiveApp\u001b[39G\u001b[39mback\u001b[44Gfrom\u001b[49G\u001b[38;5;153mapp\u001b[39m.\u001b[54GThis\u001b[59Gis\u001b[62Gthe\u001b[66Gusual\u001b[72GRatatui\u001b[80Garrangement\u001b[92Gof\u001b[95Gapp\u001b[99Gstate\r\u001b[1B  plus a renderer, and it stays inside one module. It's harmless in Rust. To break it, you could move\u001b[K\r\u001b[1B\u001b[K\r\u001b[2B\u001b[38;5;246m❯ \u001b[39m\u001b[K\r\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[3G\u001b[38;5;220m⏵⏵\u001b[6Gauto\u001b[11Gmode\u001b[16Gon\u001b[38;5;246m (shift+tab\u001b[30Gto\u001b[33Gcycle)\u001b[40G·\u001b[42Gesc\u001b[46Gto\u001b[49Ginterrupt\u001b[59G·\u001b[61G←\u001b[63Gfor\u001b[67Gagents\u001b[91G61336\u001b[97Gtokens\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?25h"]
[65.303703, "o", "\u001b[?25l\u001b[2D\u001b[3B\r\u001b[2C\u001b[5Athe\u001b[7Gstate\u001b[13Gtypes\u001b[19Ginto\u001b[24Gsomething\u001b[34Glike\u001b[39G\u001b[38;5;153minteractive/state.rs\u001b[39m,\u001b[61Gbut\u001b[65Git\u001b[68Gisn't\u001b[74Gurgent.\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[1mOther health signals\r\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[K\r\r\n\r\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[38;5;246m❯ \u001b[39m\r\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[3G\u001b[38;5;220m⏵⏵\u001b[6Gauto\u001b[11Gmode\u001b[16Gon\u001b[38;5;246m (shift+tab\u001b[30Gto\u001b[33Gcycle)\u001b[40G·\u001b[42Gesc\u001b[46Gto\u001b[49Ginterrupt\u001b[59G·\u001b[61G←\u001b[63Gfor\u001b[67Gagents\u001b[91G61336\u001b[97Gtokens\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?25h"]
