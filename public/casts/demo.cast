[46.364535, "o", "\u001b[?25l\u001b[2D\u001b[3B\r\u001b[10A\u001b[38;5;114m●\r\u001b[5C\u001b[2B\u001b[39m//! Reflex:\u001b[18GLocal-first,\u001b[31Gstructure-aware\u001b[47Gcode\u001b[52Gsearch\u001b[59Gengine\r\u001b[5C\u001b[1B//!\r\u001b[1B \u001b[3G   //! Reflex is a fast, deterministic\u001b[42Gcode\u001b[47Gsearch\u001b[54Gtool\u001b[59Gdesigned\u001b[68Gspecifically\r\u001b[5C\u001b[1B//!\u001b[10Gfor\u001b[14GAI\u001b[17Gcoding\u001b[24Gagents.\u001b[32GIt\u001b[35Gprovides\u001b[44Gstructured\u001b[55Gresults\u001b[63G(symbols,\u001b[73Gspans,\r\u001b[1B     //! scopes) with sub-100ms latency by maintaining a lightweight, incremental\u001b[K\r\u001b[1B  \u001b[6G//!\u001b[10Gcache\u001b[16Gin\u001b[19G`.reflex/`.\r\u001b[1B     //!\u001b[K\r\u001b[2C\u001b[1B   //! # Architecture\u001b[K\r\r\n\u001b[6G//!\r\r\n\u001b[6G//!\u001b[10G-\u001b[12G**Indexer**:\u001b[25GScans\u001b[31Gcode\u001b[36Gand\u001b[40Gbuilds\u001b[47Gtrigram\u001b[55Gindex;\u001b[62Gwrites\u001b[69Gto\u001b[72Gcache\r\r\n\u001b[6G//!\u001b[10G-\u001b[12G**Query\u001b[20GEngine**:\u001b[30GLoads\u001b[36Gcache\u001b[42Gon\u001b[45Gdemand;\u001b[53Gexecutes\u001b[62Gdeterministic\u001b[76Gsearches;\u001b[86Gparses\u001b[93Gsymbols\r\r\n\u001b[6Gat\u001b[9Gruntime\r\r\n\u001b[6G//!\u001b[10G-\u001b[12G**Cache**:\u001b[23GMemory-mapped\u001b[37Gstorage\u001b[45Gfor\u001b[49Gtrigrams,\u001b[59Gcontent,\u001b[68Gand\u001b[72Gmetadata\r\r\n\u001b[6G//!\r\r\n\u001b[6G//!\u001b[10G#\u001b[12GExample\u001b[20GUsage\r\r\n\u001b[6G//!\r\r\n\u001b[6G//!\u001b[10G```no_run\r\r\n\u001b[6G//!\u001b[10Guse\u001b[14Greflex::{cache::CacheManager,\u001b[44Gindexer::Indexer,\u001b[62Gmodels::IndexConfig};\r\r\n\u001b[6G//!\r\r\n\u001b[6G//!\u001b[10G//\u001b[13GCreate\u001b[20Gand\u001b[24Ginitialize\u001b[35Gindex\r\r\n\u001b[6G//!\u001b[10Glet\u001b[14Gcache\u001b[20G=\u001b[22GCacheManager::new(\".\");\r\r\n\u001b[6G//!\u001b[10Glet\u001b[14Gconfig\u001b[21G=\u001b[23GIndexConfig::default();\r\r\n\u001b