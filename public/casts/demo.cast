[54.597224, "o", "\u001b[?25l\u001b[2D\u001b[3B\r\u001b[6A\u001b[38;5;231m●\u001b[3G\u001b[39mReflex is a single Rust crate (\u001b[38;5;153mreflex\u001b[39m) with one binary,\u001b[59G\u001b[38;5;153mrfx\u001b[63G\u001b[39m(\u001b[38;5;153msrc/main.rs\u001b[39m,\u001b[77G47\u001b[80Glines),\u001b[88Gsitting\u001b[96Gon\u001b[99Ga\r\u001b[2C\u001b[1Blibrary\u001b[11G(\u001b[38;5;153msrc/lib.rs\u001b[39m).\u001b[25GThere\u001b[31Gare\u001b[35Gabout\u001b[41G86k\u001b[45Glines\u001b[51Gof\u001b[54GRust\u001b[59Gin\u001b[62G\u001b[38;5;153msrc/\u001b[39m,\u001b[68Gand\u001b[72Gthe\u001b[76GReflex\u001b[83Gindex\u001b[89Gwas\u001b[93Gup\u001b[96Gto\u001b[99Gdate\r\u001b[1B  with HEAD (\u001b[38;5;153m436f836\u001b[39m) when I ran these checks.\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[1mHow it's structured\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\r\n\u001b[3GThe\u001b[7Gcode\u001b[12Gfalls\u001b[18Ginto\u001b[23Gfive\u001b[28Glayers.\u001b[36GArrows\u001b[43Gshow\u001b[48Gthe\u001b[52Gdirection\u001b[62Gdata\u001b[67Gflows.\r\r\n\r\r\n\u001b[15G\u001b[38;5;153mCLI\u001b[19G(src/cli/)\u001b[33GMCP\u001b[37Gserver\u001b[44G(mcp.rs)\u001b[56GHTTP\u001b[61G(cli/serve.rs)\u001b[79GTUI\u001b[83G(interactive/)\u001b[39m\r\r\n\u001b[23G\u001b[38;5;153m\\\u001b[39G|\u001b[61G|\u001b[80G/\u001b[39m\r\r\n\u001b[24G\u001b[38;5;153m└──────────────┴───────\u001b[48Gquery/\u001b[55G──────┴─────────────────┘\u001b[39m\r\r\n\u001b[49G\u001b[38;5;153m│\u001b[53G(QueryEngine,\u001b[67Gfilter,\u001b[75Gzero_hint,\u001b[86Gopen_index)\u001b[39m\r\r\n\u001b[18G\u001b[38;5;153m┌──────────────────────────────┼──────────────────────────────┐\u001b[39m\r\r\n\u001b[12G\u001b[38;5;153mtrigram.rs\u001b[23G+\u001b[25Gregex_trigrams.rs\u001b[45Gcontent_store.rs\u001b[69Gparsers/\u001b[78G(tree-sitter,\u001b[92Grun\u001b[96Gat\u001b[99Gquery\u001b[39m\r\r\n\u001b[3G\u001b[38;5;153mtime)\u001b[39m\r\r\n\u001b[18G\u001b[38;5;153m└──────────────────────────────┼──────────────────────────────┘\