[6.34063, "o", "              \"query\": \"\u001b[1m\u001b[30;43mtrigram\u001b[0m\u001b[0m\",\r\n  \u001b[38;2;60;60;60m──────────────────────────────────────────────────────────────────────────────\u001b[39m\r\n    \u001b[33m 512\u001b[39m \r\n                assert_eq!(value[\"tool_calls\"][0][\"query\"], serde_json::json!(\"\u001b[1m\u001b[30;43mtrigram\u001b[0m\u001b[0m\"));\r\n  \u001b[38;2;60;60;60m──────────────────────────────────────────────────────────────────────────────\u001b[39m\r\n\r\n  \u001b[94m📁\u001b[39m \u001b[1m\u001b[96m./src/trigram.rs\u001b[39m\u001b[0m \u001b[2m(26 matches)\u001b[0m\r\n    \u001b[33m   3\u001b[39m \r\n        //! This module implements the core \u001b[1m\u001b[30;43mtrigram\u001b[0m\u001b[0m indexing algorithm used by Reflex.\r\n  \u001b[38;2;60;60;60m──────────────────────────────────────────────────────────────────────────────\u001b[39m\r\n    \u001b[33m   4\u001b[39m \r\n        //! A \u001b[1m\u001b[30;43mtrigram\u001b[0m\u001b[0m is a sequence of 3 consecutive bytes. By building an inverted index\r\n"]
[6.34064, "o", "  \u001b[38;2;60;60;60m──────────────────────────────────────────────────────────────────────────────\u001b[39m\r\n    \u001b[33m  23\u001b[39m \r\n        /// A \u001b[1m\u001b[30;43mtrigram\u001b[0m\u001b[0m is 3 consecutive bytes, packed into a u32 for efficient hashing\r\n  \u001b[38;2;60;60;60m──────────────────────────────────────────────────────────────────────────────\u001b[39m\r\n    \u001b[33m 144\u001b[39m \r\n        /// Location of a \u001b[1m\u001b[30;43mtrigram\u001b[0m\u001b[0m occurrence in the codebase\r\n  \u001b[38;2;60;60;60m──────────────────────────────────────────────────────────────────────────────\u001b[39m\r\n    \u001b[33m 165\u001b[39m \r\n        /// Serializable \u001b[1m\u001b[30;43mtrigram\u001b[0m\u001b[0m data (for rkyv zero-copy serialization)\r\n  \u001b[38;2;60;60;60m──────────────────────────────────────────────────────────────────────────────\u001b[39m\r\n    \u001b[33m 168\u001b[39m \r\n"]
[6.340652, "o", "            /// Inverted index: \u001b[1m\u001b[30;43mtrigram\u001b[0m\u001b[0m → sorted locations\r\n  \u001b[38;2;60;60;60m──────────────────────────────────────────────────────────────────────────────\u001b[39m\r\n    \u001b[33m 174\u001b[39m \r\n        /// Directory entry for lazy-loaded \u001b[1m\u001b[30;43mtrigram\u001b[0m\u001b[0m index\r\n  \u001b[38;2;60;60;60m──────────────────────────────────────────────────────────────────────────────\u001b[39m\r\n    \u001b[33m 176\u001b[39m \r\n        /// Maps each \u001b[1m\u001b[30;43mtrigram\u001b[0m\u001b[0m to its compressed posting list location in the data section.\r\n  \u001b[38;2;60;60;60m──────────────────────────────────────────────────────────────────────────────\u001b[39m\r\n    \u001b[33m 180\u001b[39m \r\n            /// The \u001b[1m\u001b[30;43mtrigram\u001b[0m\u001b[0m value (for binary search)\r\n  \u001b[38;2;60;60;60m──────────────────────────────────────────────────────────────────────────────\u001b[39m\r\n    \u001b[33m 181\u001b[39m \r\n            \u001b[1m\u001b[30;43mtrigram\u001b[0m\u001b[0m: Trigram,\r\n  \u001b[38;2;60;60;60m──────────────────────────────────────────────────────────────────────────────\u001b[39m\r\n    \u001b[33m 190\u001b[39m \r\n        /// Maps each \u001b[1m\u001b[30;43mtrigram\u001b[0m\u001b[0m to a sorted list of locations where it appears.\r\n  \u001b[38;2;60;60;60m──────────────────────────────────────────────────────────────────────────────\u001b[39m\r\n    \u001b[33m 192\u001b[39m \r\n        /// The index itself is kept sorted by \u001b[1m\u001b[30;43mtrigram\u001b[0m\u001b[0m for O(log n) binary search.\r\n"]
