[6.340688, "o", "                // Sort by \u001b[1m\u001b[30;43mtrigram\u001b[0m\u001b[0m\r\n  \u001b[38;2;60;60;60m──────────────────────────────────────────────────────────────────────────────\u001b[39m\r\n    \u001b[33m 270\u001b[39m \r\n                partial_index.sort_unstable_by_key(|(\u001b[1m\u001b[30;43mtrigram\u001b[0m\u001b[0m, _)| *trigram);\r\n  \u001b[38;2;60;60;60m──────────────────────────────────────────────────────────────────────────────\u001b[39m\r\n    \u001b[33m 309\u001b[39m \r\n                // Write each (\u001b[1m\u001b[30;43mtrigram\u001b[0m\u001b[0m, posting_list)\r\n  \u001b[38;2;60;60;60m──────────────────────────────────────────────────────────────────────────────\u001b[39m\r\n    \u001b[33m 310\u001b[39m \r\n                for (\u001b[1m\u001b[30;43mtrigram\u001b[0m\u001b[0m, locations) in index {\r\n  \u001b[38;2;60;60;60m──────────────────────────────────────────────────────────────────────────────\u001b[39m\r\n    \u001b[33m 311\u001b[39m \r\n                    writer.write_all(&\u001b[1m\u001b[30;43mtrigram\u001b[0m\u001b[0m.to_le_bytes())?;\r\n  \u001b[38;2;60;60;60m──────────────────────────────────────────────────────────────────────────────\u001b[39m\r\n    \u001b[33m 362\u001b[39m \r\n"]
