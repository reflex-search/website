[6.340508, "o", "                    // Use the new search_ast_all_files method (no \u001b[1m\u001b[30;43mtrigram\u001b[0m\u001b[0m filtering)\r\n  \u001b[38;2;60;60;60m──────────────────────────────────────────────────────────────────────────────\u001b[39m\r\n\r\n  \u001b[94m📁\u001b[39m \u001b[1m\u001b[96m./src/pulse/wiki.rs\u001b[39m\u001b[0m \u001b[2m(1 match)\u001b[0m\r\n    \u001b[33m1226\u001b[39m \r\n            // Count references for priority-kind symbols only via the \u001b[1m\u001b[30;43mtrigram\u001b[0m\u001b[0m index.\r\n  \u001b[38;2;60;60;60m──────────────────────────────────────────────────────────────────────────────\u001b[39m\r\n\r\n  \u001b[94m📁\u001b[39m \u001b[1m\u001b[96m./src/query.rs\u001b[39m\u001b[0m \u001b[2m(39 matches)\u001b[0m\r\n    \u001b[33m  18\u001b[39m \r\n        use crate::\u001b[1m\u001b[30;43mtrigram\u001b[0m\u001b[0m::TrigramIndex;\r\n  \u001b[38;2;60;60;60m──────────────────────────────────────────────────────────────────────────────\u001b[39m\r\n    \u001b[33m 390\u001b[39m \r\n                // not just the first 100 candidates from \u001b[1m\u001b[30;43mtrigram\u001b[0m\u001b[0m search.\r\n"]
[6.340521, "o", "  \u001b[38;2;60;60;60m──────────────────────────────────────────────────────────────────────────────\u001b[39m\r\n    \u001b[33m 415\u001b[39m \r\n                // This check happens BEFORE the expensive \u001b[1m\u001b[30;43mtrigram\u001b[0m\u001b[0m search to prevent hangs on large indexes\r\n  \u001b[38;2;60;60;60m──────────────────────────────────────────────────────────────────────────────\u001b[39m\r\n    \u001b[33m 422\u001b[39m \r\n                // 3. Not using regex (regex has its own \u001b[1m\u001b[30;43mtrigram\u001b[0m\u001b[0m extraction) AND\r\n  \u001b[38;2;60;60;60m──────────────────────────────────────────────────────────────────────────────\u001b[39m\r\n    \u001b[33m 469\u001b[39m \r\n                    // This ensures we find ALL classes/functions/etc, not just those in the first 100…\r\n  \u001b[38;2;60;60;60m──────────────────────────────────────────────────────────────────────────────\u001b[39m\r\n    \u001b[33m 471\u001b[39m \r\n                        log::info!(\"Keyword query detected for '{}' - scanning all {:?} files (bypassing…\r\n  \u001b[38;2;60;60;60m──────────────────────────────────────────────────────────────────────────────\u001b[39m\r\n    \u001b[33m 474\u001b[39m \r\n                        log::info!(\"Keyword query detected for '{}' - scanning all files (bypassing \u001b[1m\u001b[30;43mtrigram\u001b[0m\u001b[0m…\r\n  \u001b[38;2;60;60;60m──────────────────────────────────────────────────────────────────────────────\u001b[39m\r\n    \u001b[33m 478\u001b[39m \r\n                    // Regex pattern search with \u001b[1m\u001b[30;43mtrigram\u001b[0m\u001b[0m optimization\r\n  \u001b[38;2;60;60;60m──────────────────────────────────────────────────────────────────────────────\u001b[39m\r\n    \u001b[33m 481\u001b[39m \r\n                    // Standard \u001b[1m\u001b[30;43mtrigram\u001b[0m\u001b[0m-based full-text search\r\n"]
[6.340535, "o", "  \u001b[38;2;60;60;60m──────────────────────────────────────────────────────────────────────────────\u001b[39m\r\n    \u001b[33m 612\u001b[39m \r\n                    // Condition 1: Pattern too short (< 3 chars can't use \u001b[1m\u001b[30;43mtrigram\u001b[0m\u001b[0m optimization efficiently)\r\n  \u001b[38;2;60;60;60m──────────────────────────────────────────────────────────────────────────────\u001b[39m\r\n    \u001b[33m 625\u001b[39m \r\n                    // - Trigram-filtered symbols: 50,000 files (~5 seconds max) - very fast due to \u001b[1m\u001b[30;43mtrigram\u001b[0m\u001b[0m…\r\n  \u001b[38;2;60;60;60m──────────────────────────────────────────────────────────────────────────────\u001b[39m\r\n    \u001b[33m 641\u001b[39m \r\n                            format!(\"Pattern '{}' is too short ({} characters). Short patterns bypass…\r\n  \u001b[38;2;60;60;60m──────────────────────────────────────────────────────────────────────────────\u001b[39m\r\n    \u001b[33m 861\u001b[39m \r\n            /// Execute AST query on all indexed files (no \u001b[1m\u001b[30;43mtrigram\u001b[0m\u001b[0m filtering)\r\n  \u001b[38;2;60;60;60m──────────────────────────────────────────────────────────────────────────────\u001b[39m\r\n    \u001b[33m 874\u001b[39m \r\n            /// - Parses entire codebase (not just \u001b[1m\u001b[30;43mtrigram\u001b[0m\u001b[0m candidates)\r\n"]
